{
  "name": "condex",
  "version": "0.1.0",
  "private": true,
  "description": "ConDex off-chain services: API, MCP server, private storage, execution integration and a mock NEAR ledger.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/main.ts",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/main.ts",
    "mcp": "node --disable-warning=ExperimentalWarning src/mcp/server.ts",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.ts",
    "test:page": "node --disable-warning=ExperimentalWarning scripts/check-test-page.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  }
}
