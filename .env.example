# --- Where the app gets its data ---
# true: built-in demo data, no backend needed. false: talk to the ConDex backend.
NEXT_PUBLIC_USE_MOCKS=true
NEXT_PUBLIC_MOCK_FAIL_RATE=0

# The path the browser calls. "/backend" is forwarded by Next to BACKEND_URL below, so the backend needs no CORS.
# A full URL also works if the backend allows this site's origin.
NEXT_PUBLIC_API_BASE_URL=/backend
# Where `next dev` forwards /backend/*. Server-side only, not exposed to the browser.
BACKEND_URL=http://localhost:8787
# The backend address Claude Code's MCP server uses. It runs on the user's machine, so this is a real URL.
NEXT_PUBLIC_MCP_API_URL=http://localhost:8787

# --- NEAR ---
NEXT_PUBLIC_NEAR_NETWORK=testnet
NEXT_PUBLIC_CONTRACT_ID=                # fill when the contract is deployed
NEXT_PUBLIC_EXPLORER_TX_URL=https://testnet.nearblocks.io/txns/   # VERIFY
